# API base URL used by the browser client.
# During local development, Vite proxies /api to the FastAPI backend.
VITE_API_BASE_URL="/api/v1"

# Native Tauri release builds cannot use the relative /api proxy path.
# Set VITE_API_BASE_URL to an absolute http(s) URL for Desktop or Android release builds
# (`npm run native:build`, `native:android:run`, `native:android:build:apk` or `:aab`),
# preferably HTTPS outside local development (for example https://api.example.com/api/v1).
