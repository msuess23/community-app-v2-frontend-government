{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Community-App Behördenclient",
  "version": "0.1.0",
  "identifier": "de.hof.community.authority",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Community-App · Behördenclient",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws:",
        "font-src": "'self' data:",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
